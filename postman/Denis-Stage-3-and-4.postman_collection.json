    {
      "name": "05 - Offres publiques paginées",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ads?page=1&page_size=10&sort=recent"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Réponse paginée et offres publiées\", () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.ads).to.be.an(\"array\").that.has.lengthOf.at.most(10);",
              "  pm.expect(body.total).to.be.a(\"number\");",
              "  pm.expect(body.page).to.eql(1);",
              "  pm.expect(body.page_size).to.eql(10);",
              "  pm.expect(body.total_pages).to.eql(Math.ceil(body.total / 10));",
              "  pm.expect(body.ads.every((ad) => ad.status === \"published\")).to.eql(true);",
              "  if (body.ads.length) pm.collectionVariables.set(\"existingAdId\", body.ads[0].id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Tri salarial",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ads?page=1&page_size=20&sort=salary_desc"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function annualSalary(ad) {",
              "  const amount = ad.salary_min ?? ad.salary_max;",
              "  if (amount == null) return null;",
              "  return amount * (ad.salary_period === \"month\" ? 12 : 1);",
              "}",
              "pm.test(\"Salaires décroissants et montants absents à la fin\", () => {",
              "  pm.response.to.have.status(200);",
              "  const salaries = pm.response.json().ads.map(annualSalary);",
              "  const known = salaries.filter((amount) => amount !== null);",
              "  const missing = salaries.filter((amount) => amount === null);",
              "  pm.expect(known).to.eql([...known].sort((a, b) => b - a));",
              "  pm.expect(salaries.slice(known.length)).to.eql(missing);",
              "});"
            ]
          }
        }
      ]
    },

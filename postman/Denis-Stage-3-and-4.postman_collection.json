          "raw": "{{baseUrl}}/api/admin/ads"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get(\"baseUrl\"), (error) => {",
              "  if (error) console.log(\"Impossible de vider le cookie de session\", error);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Un visiteur reçoit 401\", () => pm.response.to.have.status(401));"
            ]
